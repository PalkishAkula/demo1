  "faqs": [
    {
      "question": "How soon will I receive my report?",
      "answer": "Most routine blood reports are shared within 6 hours. Some specialised tests take longer and the team confirms that at booking."
    }
  ],
  "contactFaqs": [
    {
      "question": "Can I walk in for a test?",
      "answer": "Yes. Fasting and imaging tests are easier when you call first."
    },
    {
      "question": "Is home collection available?",
      "answer": "Yes, across listed Vijayawada areas from 6:00 AM."
    },
    {
      "question": "Do I need a prescription?",
      "answer": "Bring one when your doctor has given it. Routine preventive packages can be booked directly."
    },
    {
      "question": "How are reports delivered?",
      "answer": "We send the report link to your WhatsApp number after the report is verified."
    },
    {
      "question": "Is parking available?",
      "answer": "Two-wheelers can park in front of Sai Arcade. Paid car parking is on MG Road."
    },
    {
      "question": "What are Sunday timings?",
      "answer": "The centre is open from 7:00 AM to 1:00 PM on Sunday."
    }
  ],
  "about": {
    "story": [
      "Krishna Path Labs began in Governorpet in 2008 to make routine testing easier for local families and referring doctors.",
      "The centre added home collection across Vijayawada as more patients needed fasting samples taken before work or travel.",
      "Today the lab combines a clear booking process with pathologist-reviewed reports."
    ],
